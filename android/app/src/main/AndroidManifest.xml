<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sync engine + demo login both need network. No CALL_PHONE permission
         is requested anywhere in this app: lead call/WhatsApp/email actions
         use ACTION_DIAL (hands off to the Phone app to place the call) and
         ACTION_VIEW/ACTION_SENDTO, none of which need a runtime permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- API 30+ package-visibility: these standard actions (dialer, SMS/
         WhatsApp compose, email compose, plain-text share sheet) are on
         Android's documented implicit-visibility allowlist already, but
         declaring them here removes any doubt and keeps Intent.resolveActivity
         / createChooser reliable across OEM builds. No app identities are
         queried — just these action+scheme/type combinations. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".OpsApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Ops">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ops"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager is initialised manually via OpsApplication implementing
             Configuration.Provider (so Hilt can inject a HiltWorkerFactory into
             workers) — the default WorkManagerInitializer content provider must
             be disabled to avoid double-initialisation. See OpsApplication.kt. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Lets the system Camera app (launched via ACTION_IMAGE_CAPTURE,
             see ExpenseEditScreen) write a photo to a content:// Uri this app
             can then read — no storage permission needed either way; the
             camera capture flow needs no CAMERA runtime permission since it
             delegates to the Camera app via an implicit intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
