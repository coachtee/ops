<?xml version="1.0" encoding="utf-8"?>
<!--
  This vertical slice targets a local Django dev server over plain HTTP
  (see BASE_URL in app/build.gradle.kts). Android blocks cleartext traffic by
  default on API 28+, so it is explicitly allowed here, scoped to only the
  hosts a dev/demo setup uses: the Android emulator's host-loopback alias and
  plain localhost. A real deployment would point BASE_URL at an HTTPS host
  and this whole cleartext exception would be removed.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
