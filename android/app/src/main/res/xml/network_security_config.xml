<?xml version="1.0" encoding="utf-8"?>
<!--
  The release/production network security config: cleartext HTTP is never
  permitted, full stop — Android's own secure default. Debug builds get a
  permissive override at app/src/debug/res/xml/network_security_config.xml
  (same filename, picked up automatically by Gradle's per-variant resource
  merging), since a debug APK is never what a real customer installs and
  development/UAT routinely targets a plain-HTTP LAN Django server. This
  file is what a release build actually ships with.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
